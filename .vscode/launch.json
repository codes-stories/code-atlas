{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/extension/**/*.js"
      ],
      "preLaunchTask": "npm: build:ext",
      "sourceMaps": true
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/dist/tests/index.js"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Extension + Watch",
      "configurations": ["Run Extension"],
      "preLaunchTask": "npm: watch",
      "stopAll": true
    }
  ]
}
