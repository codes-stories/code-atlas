# VS Code & tooling
.vscode/**
.vscode-test/**

# Source — not needed at runtime (dist/ is used)
src/**
scripts/**

# Tests & fixtures — not shipped
tests/**
fixtures/**

# Config files
.gitignore
.gitattributes
.editorconfig
.eslintrc.json
.prettierrc.json
.prettierignore
tsconfig.json
tsconfig.extension.json
tsconfig.webview.json
vitest.config.ts
vitest.integration.config.ts
vitest.perf.config.ts

# Build artefacts
*.vsix
**/*.map
**/*.ts

# Negations — files that MUST be included
!dist/**/*.js
!grammars/**
!assets/**
